{
  "name": "@puuid/core",
  "version": "0.1.44",
  "description": "Core utilities for puuid.com",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./lib/*": {
      "import": "./dist/lib/*.js",
      "types": "./dist/lib/*.d.ts"
    },
    "./shared": {
      "import": "./dist/shared/index.js",
      "types": "./dist/shared/index.d.ts"
    },
    "./shared/*": {
      "import": "./dist/shared/*.js",
      "types": "./dist/shared/*.d.ts"
    },
    "./shared/services": {
      "import": "./dist/shared/services/index.js",
      "types": "./dist/shared/services/index.d.ts"
    },
    "./shared/services/DDragonService": {
      "import": "./dist/shared/services/DDragonService/index.js",
      "types": "./dist/shared/services/DDragonService/index.d.ts"
    },
    "./shared/services/DDragonService/*": {
      "import": "./dist/shared/services/DDragonService/*.js",
      "types": "./dist/shared/services/DDragonService/*.d.ts"
    },
    "./server/api-route": {
      "import": "./dist/server/api-route/index.js",
      "types": "./dist/server/api-route/index.d.ts"
    },
    "./server/api-route/*": {
      "import": "./dist/server/api-route/*.js",
      "types": "./dist/server/api-route/*.d.ts"
    },
    "./server/db": {
      "import": "./dist/server/db/index.js",
      "types": "./dist/server/db/index.d.ts"
    },
    "./server/db/*": {
      "import": "./dist/server/db/*.js",
      "types": "./dist/server/db/*.d.ts"
    },
    "./server/lib": {
      "import": "./dist/server/lib/index.js",
      "types": "./dist/server/lib/index.d.ts"
    },
    "./server/lib/*": {
      "import": "./dist/server/lib/*.js",
      "types": "./dist/server/lib/*.d.ts"
    },
    "./server/services": {
      "import": "./dist/server/services/index.js",
      "types": "./dist/server/services/index.d.ts"
    },
    "./server/services/*": {
      "import": "./dist/server/services/*.js",
      "types": "./dist/server/services/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "prebuild": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true });\"",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node ./scripts/fix-esm.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "publish:npm": "npm publish --access public",
    "db:migration": "bunx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:studio": "npx drizzle-kit studio"
  },
  "keywords": [
    "puuid",
    "core"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puuid-com/core.git"
  },
  "bugs": {
    "url": "https://github.com/puuid-com/core/issues"
  },
  "homepage": "https://github.com/puuid-com/core#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "@vibrant/image-node": "^4.0.0",
    "better-auth": "^1.3.11",
    "drizzle-orm": "^0.44.5",
    "ky": "^1.10.0",
    "minio": "^8.0.6",
    "node-vibrant": "^4.0.3",
    "pg": "^8.16.3",
    "rate-limiter-flexible": "^7.3.1",
    "uuidv7": "^1.0.2",
    "valibot": "^1.1.0"
  }
}
