{
  "name": "@puuid/core",
  "version": "0.1.0",
  "description": "Core utilities for puuid.com",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "puuid",
    "core"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puuid-com/core.git"
  },
  "bugs": {
    "url": "https://github.com/puuid-com/core/issues"
  },
  "homepage": "https://github.com/puuid-com/core#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.5",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "@vibrant/image-node": "^4.0.0",
    "better-auth": "^1.3.11",
    "drizzle-orm": "^0.44.5",
    "ky": "^1.10.0",
    "minio": "^8.0.6",
    "node-vibrant": "^4.0.3",
    "pg": "^8.16.3",
    "rate-limiter-flexible": "^7.3.1",
    "uuidv7": "^1.0.2",
    "valibot": "^1.1.0"
  }
}
